manual/*.out
manual/*.toc

# Personal files
*.xlsx

# Crash / error logs (local only)
_crash_report.json
backfocus_errors.log

# Progress tracking (local only)
_progress.json

# AI context (local only)
CLAUDE.md

# PyInstaller build artifacts
build/
dist/
*.spec

